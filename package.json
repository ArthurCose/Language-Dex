{
  "name": "language-dex",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "APP_VARIANT=development npm run prebuild-android && expo run:android",
    "android-cached": "APP_VARIANT=development expo run:android",
    "build-android": "npm run licenses && npm run prebuild-android && cd android && ./gradlew --stop && dotenv -e ../.env.build.local -- ./gradlew app:bundleRelease && echo bundle saved to android/app/build/outputs/bundle/release",
    "build-android-apk": "npm run licenses && npm run prebuild-android && cd android && ./gradlew --stop && dotenv -e ../.env.build.local -- ./gradlew app:assembleRelease && echo bundle saved to android/app/build/outputs/apk/release",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "go": "expo start --go",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "prebuild-android": "rimraf android; expo prebuild -p android && tsx scripts/patch-gradle.ts",
    "licenses": "license-ripper --config license-ripper-config.json --output -licenses.json --compress; tsx scripts/license-post-rip.ts"
  },
  "dependencies": {
    "@akahuku/unistring": "^0.6.2",
    "@expo/dom-webview": "~58.0.2",
    "@expo/log-box": "^58.0.12",
    "@expo/metro-runtime": "~58.0.14",
    "@gorhom/bottom-sheet": "^5.1.8",
    "@react-native-vector-icons/material-design-icons": "^13.1.2",
    "@react-native/metro-config": "^0.88.0",
    "@rn-primitives/dropdown-menu": "^1.1.0",
    "@rn-primitives/portal": "^1.1.0",
    "@rn-primitives/types": "^1.1.0",
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.23",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "i18next": "*",
    "react": "19.3.0",
    "react-i18next": "^15.4.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "4.7.1",
    "react-native-reorderable-list": "^0.9.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-uuid": "^2.0.3",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.1.6",
    "@eslint/js": "^9.19.0",
    "@jest/globals": "^30.4.1",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "dotenv-cli": "11",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "license-ripper": "0.10",
    "metro-react-native-babel-transformer": "^0.77.0",
    "react-dom": "19.3.0",
    "react-native-nitro-modules": "^0.35.0",
    "react-native-svg-transformer": "^1.5.0",
    "rimraf": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          ".*"
        ]
      }
    }
  },
  "private": true
}
