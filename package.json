{
  "name": "language-dex",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "APP_VARIANT=development npm run prebuild-android && expo run:android",
    "android-cached": "APP_VARIANT=development expo run:android",
    "build-android": "npm run licenses && npm run prebuild-android && cd android && ./gradlew --stop && dotenv -e ../.env.build.local -- ./gradlew app:bundleRelease && echo bundle saved to android/app/build/outputs/bundle/release",
    "build-android-apk": "npm run licenses && npm run prebuild-android && cd android && ./gradlew --stop && dotenv -e ../.env.build.local -- ./gradlew app:assembleRelease && echo bundle saved to android/app/build/outputs/apk/release",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "go": "expo start --go",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "prebuild-android": "rimraf android; expo prebuild -p android && tsx scripts/patch-gradle.ts",
    "licenses": "license-ripper --config license-ripper-config.json --output -licenses.json --compress; tsx scripts/license-post-rip.ts"
  },
  "dependencies": {
    "@akahuku/unistring": "^0.6.2",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.3",
    "@expo/dom-webview": "^55.0.6",
    "@expo/log-box": "^55.0.13",
    "@gorhom/bottom-sheet": "^5.1.8",
    "@react-native/metro-config": "^0.86.2",
    "@rn-primitives/dropdown-menu": "^1.1.0",
    "@rn-primitives/portal": "^1.1.0",
    "@rn-primitives/types": "^1.1.0",
    "expo": "^55.0.0",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-build-properties": "~55.0.16",
    "expo-clipboard": "~55.0.15",
    "expo-constants": "~55.0.17",
    "expo-document-picker": "~55.0.15",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-localization": "~55.0.17",
    "expo-router": "~55.0.17",
    "expo-sharing": "~55.0.22",
    "expo-splash-screen": "~55.0.23",
    "expo-sqlite": "~55.0.18",
    "i18next": "*",
    "react": "19.2.0",
    "react-i18next": "^15.4.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "4.2.1",
    "react-native-reorderable-list": "^0.9.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-uuid": "^2.0.3",
    "react-native-worklets": "^0.7.4"
  },
  "optionalDependencies": {
    "react-native-google-mobile-ads": "^15.8.3",
    "react-native-iap": "^14.4.39"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.1.6",
    "@eslint/js": "^9.19.0",
    "@jest/globals": "^30.4.1",
    "@testing-library/dom": "^10.4.1",
    "@types/react": "~19.2.0",
    "babel-plugin-optional-require": "^0.3.1",
    "dotenv-cli": "11",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "license-ripper": "0.10",
    "metro-react-native-babel-transformer": "^0.77.0",
    "react-dom": "19.2.0",
    "react-native-nitro-modules": "^0.35.0",
    "react-native-svg-transformer": "^1.5.0",
    "rimraf": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          ".*"
        ]
      }
    }
  },
  "private": true
}
